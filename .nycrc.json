{
  "check-coverage": true,
  "lines": 80,
  "functions": 80,
  "branches": 80,
  "statements": 80,
  "include": [
    "src/**/*.{ts,tsx}",
    "security/**/*.ts"
  ],
  "exclude": [
    "src/main.tsx",
    "**/*.test.*",
    "**/*.spec.*",
    "src/components/**"
  ],
  "reporter": ["text-summary", "text"],
  "temp-dir": ".nyc_output"
}

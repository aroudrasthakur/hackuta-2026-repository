{
  "name": "hackuta-2026-odyssey",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "typecheck:convex": "tsc -p convex/tsconfig.json --noEmit",
    "lint": "eslint src convex",
    "assets": "node scripts/prepare-assets.mjs",
    "qa:mcp": "node scripts/qa-mcp.mjs",
    "ensure:convex-stub": "node scripts/ensure-convex-server-stub.mjs",
    "pretest:unit": "node scripts/ensure-convex-server-stub.mjs",
    "pretest:unit:coverage": "node scripts/ensure-convex-server-stub.mjs",
    "pretypecheck:convex": "node scripts/ensure-convex-server-stub.mjs",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:coverage:check": "node scripts/check-coverage.mjs",
    "test:e2e": "playwright test",
    "convex:seed": "convex run seed:seedHackathon",
    "test:convex:deployment": "node scripts/verify-convex-deployment.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@paper-design/shaders-react": "^0.0.80",
    "@redesigner/wave.js": "^1.3.0",
    "convex": "^1.45.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/mcp": "^0.0.80",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "beasties": "^0.5.4",
    "convex-test": "^0.0.58",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "nyc": "^18.0.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-beasties": "^0.5.4",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^5.0.1",
    "wawoff2": "^2.0.1"
  }
}

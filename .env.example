# Copy to .env.local for local development.
# In production, set these in your host's environment (e.g. Vercel project settings).

# Convex deployment URL (Dashboard → Settings → Deployment URL)
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Convex CLI deployment selector (local development/CI only)
CONVEX_DEPLOYMENT=

# Convex Auth site URL (the https://<deployment>.convex.site URL)
CONVEX_SITE_URL=

# Set only in the deployment environment; never expose as VITE_*.
CONVEX_AUTH_TOKEN=

REGISTRATION_TOKEN_SECRET=

# Required on the Convex deployment. Comma-separated exact browser origins
# allowed to upload resumes, e.g. https://hackuta.org,https://www.hackuta.org
REGISTRATION_ALLOWED_ORIGINS=

# Comma-separated Convex Auth tokenIdentifier values allowed to list hackathon
# registrations, e.g. organizer accounts synced through Convex Auth.
REGISTRATION_ADMIN_IDENTITY_KEYS=

# Test builds only. Keep false for real local and production deployments.
VITE_USE_MOCK_API=false

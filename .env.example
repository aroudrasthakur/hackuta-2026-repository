# LOCAL DEVELOPMENT (zero-cost testing)
# Uses file-based storage (.vercel/registrations.json) and console email logging.
# No external services required — perfect for testing the flow locally.

# Token signing secret for email verification tokens (32-byte hex string).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REGISTRATION_TOKEN_SECRET=


# PRODUCTION DEPLOYMENT (requires paid services)
# For production on Vercel, add these environment variables in the
# Vercel dashboard (Settings > Environment Variables):

# Resend (https://resend.com) — email service for verification codes.
# RESEND_API_KEY=re_xxxxx...
# RESEND_FROM_EMAIL="HackUTA <register@hackuta.org>"

# Upstash Redis (Vercel Marketplace > Storage > Redis) — persistent data.
# KV_REST_API_URL=https://...upstash.io
# KV_REST_API_TOKEN=...

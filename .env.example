# Copy to .env.local for local development.
# In production, set these in your host's environment (e.g. Vercel project settings).

# Convex deployment URL (Dashboard → Settings → Deployment URL)
VITE_CONVEX_URL=

# Convex CLI deployment selector (local development/CI only)
CONVEX_DEPLOYMENT=

# Convex Auth site URL (the https://<deployment>.convex.site URL)
CONVEX_SITE_URL=

# Set only in the deployment environment; never expose as VITE_*.
CONVEX_AUTH_TOKEN=

REGISTRATION_TOKEN_SECRET=

VITE_USE_MOCK_API=true

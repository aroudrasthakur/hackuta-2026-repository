# Public Convex deployment URL used by the registration actions.
VITE_CONVEX_URL=

# Server-side Convex variables. Configure these in the Convex dashboard, never in Vite.
# cPanel SMTP credentials for hello@hackuta.org.
# SMTP_HOST=mail.hackuta.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=hello@hackuta.org
# SMTP_PASSWORD=
# SMTP_FROM=hello@hackuta.org

# The registration flow requires a real email provider; mock verification is not supported.
VITE_USE_MOCK_API=false

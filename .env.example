# Copy to .env.local for local development.
# In production, set these in your host's environment (e.g. Vercel project settings).

# Convex deployment URL (Dashboard → Settings → Deployment URL)
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Required on the Convex deployment. Comma-separated exact browser origins
# allowed to upload resumes, e.g. https://hackuta.org,https://www.hackuta.org
REGISTRATION_ALLOWED_ORIGINS=

VITE_USE_MOCK_API=true
